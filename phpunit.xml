<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!--
            Must stay "array". With the database store, running the suite in
            parallel fails ~10 tests: the store captures a Connection before
            parallel testing swaps in the per-process database, and reaching for
            it later reconnects by name, which silently discards the transaction
            RefreshDatabase wraps each test in.
            Upstream bug, open since 2025: https://github.com/laravel/framework/issues/54716
            A test that genuinely needs the database store can still opt in
            per-test with Cache::store('database'), which resolves lazily.
        -->
        <env name="CACHE_DRIVER" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="laravel_test"/>
        <env name="DB_USERNAME" value="david" force="false"/>
        <env name="DB_PASSWORD" value="" force="false"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="database"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="APP_URL" value="http://davidharting-dot-com.test" />
        <env name="TELEGRAM_DAVID_ID" value="123456789" />
        <env name="LOG_CHANNEL" value="null" />
        <env name="IS_PULL_REQUEST" value="false" />
        <env name="RENDER_GIT_COMMIT" value="abcdef1234567890abcd" />
        <env name="RENDER_GIT_BRANCH" value="my-feature-branch" />
        <env name="RENDER_SERVICE_NAME" value="davidhartingdotcom-web-pr-999" />
    </php>
</phpunit>
